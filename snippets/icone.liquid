{% doc %}
  Icônes fonctionnelles (trait 1,5 px, couleur du texte). Décoratives :
  le bouton ou le lien qui les porte doit avoir un nom accessible.

  @param {string} nom - 'panier', 'fermer', 'gauche', 'droite', 'plus', 'moins', 'loupe', 'menu', 'cadenas', 'retour', 'bouclier', 'camion', 'recherche'
{% enddoc %}
