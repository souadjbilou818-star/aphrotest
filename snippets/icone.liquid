  {%- when 'droite' -%}
    <svg class="icone" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"/></svg>
  {%- when 'plus' -%}
    <svg class="icone" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'moins' -%}
