{% doc %}
  Choix des variantes, une liste de boutons radio par option du produit.
  Le composant <aplomb-variantes> retrouve la variante correspondante et met
  à jour le prix, la disponibilité, les formulaires d’achat et l’adresse.
  Pour un produit à une seule option, chaque choix affiche son prix et, s’il
  est rempli, le metafield de variante aplomb.contenu (ce que contient l’édition).

  @param {object} product - le produit
  @param {string} uid - identifiant unique (section.id)
  @param {number} [seuil] - seuil du badge « Plus que N en stock » (0 : jamais)
{% enddoc %}
{%- unless product.has_only_default_variant -%}
  <aplomb-variantes class="variantes" data-uid="{{ uid }}">
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign nom_option = option.name | downcase
        assign pastilles = false
        if nom_option contains 'couleur' or nom_option contains 'color' or nom_option contains 'coloris'
          assign pastilles = true
        endif
      -%}
      <fieldset class="options{% if pastilles %} options--pastilles{% endif %}">
        <legend class="label">
          {{- option.name -}}
          {%- if pastilles %} : <span class="options__choix" data-choix-option="{{ option.position }}">{{ option.selected_value }}</span>{% endif -%}
        </legend>
        <div class="options__liste">
          {%- for valeur in option.values -%}
            {%- liquid
              assign nom = valeur.name | default: valeur
              assign v_seule = nil
              if product.options.size == 1
                for v in product.variants
                  if v.option1 == nom
                    assign v_seule = v
                  endif
                endfor
              endif
            -%}
            <label class="option{% if pastilles %} option--pastille{% endif %}"{% if pastilles %} title="{{ nom | escape }}"{% endif %}>
              <input
                type="radio"
                name="option{{ option.position }}-{{ uid }}"
                value="{{ nom | escape }}"
                data-position="{{ option.position }}"
                {% if option.selected_value == nom %}
                  checked
                {% endif %}
              >
              {%- if pastilles -%}
                {%- liquid
                  assign teinte = valeur.swatch.color | default: ''
                  if teinte == ''
                    assign nb = nom | downcase
                    if nb contains 'rose'
                      assign teinte = '#e8b9c4'
                    elsif nb contains 'blanc' or nb contains 'ivoire'
                      assign teinte = '#f3efe6'
                    elsif nb contains 'noir'
                      assign teinte = '#1b1d1c'
                    elsif nb contains 'vert' or nb contains 'forêt'
                      assign teinte = '#1f3a34'
                    elsif nb contains 'bordeaux'
                      assign teinte = '#5b1f2b'
                    elsif nb contains 'violet' or nb contains 'lavande'
                      assign teinte = '#9b86c5'
                    elsif nb contains 'gris'
                      assign teinte = '#9a9a96'
                    else
                      assign teinte = '#d9c8b2'
                    endif
                  endif
                -%}
                <span class="option__pastille" style="--teinte: {{ teinte }}" aria-hidden="true"></span>
                <span class="visually-hidden">{{ nom }}</span>
              {%- else -%}
                <span class="option__nom">{{ nom }}</span>
              {%- endif -%}
              {%- if v_seule and pastilles == false -%}
                <span class="option__prix">{% render 'prix', montant: v_seule.price %}</span>
                {%- if v_seule.metafields.aplomb.contenu != blank -%}
                  <span class="option__contenu">{{ v_seule.metafields.aplomb.contenu }}</span>
                {%- endif -%}
                {%- unless v_seule.available -%}
                  <span class="option__etat">{{ 'aplomb.produit.dispo_epuise' | t }}</span>
                {%- endunless -%}
              {%- endif -%}
            </label>
          {%- endfor -%}
        </div>
      </fieldset>
    {%- endfor -%}
    <script type="application/json" data-variantes>
      [
        {%- for v in product.variants -%}
          {%- capture prix_v -%}{% render 'prix', montant: v.price %}{%- endcapture -%}
          {%- liquid
            assign stock_v = 'null'
            if seuil > 0 and v.inventory_management == 'shopify' and v.inventory_quantity > 0 and v.inventory_quantity <= seuil
              assign stock_v = v.inventory_quantity
            endif
          -%}
          {"id":{{ v.id }},"titre":{{ v.title | json }},"options":{{ v.options | json }},"disponible":{{ v.available | json }},"prix":{{ prix_v | json }},"stock_bas":{{ stock_v }}}
          {%- unless forloop.last %},{% endunless -%}
        {%- endfor -%}
      ]
    </script>
  </aplomb-variantes>
{%- endunless -%}
