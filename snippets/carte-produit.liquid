{% doc %}
  Carte produit (collections, familles, recommandations).
  Prix réel du produit (« dès » quand les variantes ont des prix différents),
  état commercial honnête : en vente, épuisé ou liste d’attente.

  @param {object} product - le produit
  @param {string} [sizes] - attribut sizes de l’image
  @param {boolean} [prioritaire] - première rangée : chargement immédiat
  @param {string} [titre_balise] - 'h2' ou 'h3' (défaut)
  @param {boolean} [compacte] - image carrée, coloris, nom, prix (rangées de fiche produit)
{% enddoc %}
{%- liquid
  assign titre_balise = titre_balise | default: 'h3'
  assign sizes = sizes | default: '(min-width: 1000px) 30vw, (min-width: 640px) 46vw, 92vw'
  capture etat
    render 'etat-produit', product: product
  endcapture
  assign etat = etat | strip
  capture prix
    render 'prix', montant: product.price_min
  endcapture
  assign famille = product.metafields.aplomb.famille.value | default: product.type
  assign image = product.featured_media.preview_image
  assign alt = product.featured_media.alt | default: product.title
  assign alt_bas = alt | downcase
  assign contenu = false
  if image != blank
    assign ecart = image.aspect_ratio | minus: 0.8 | abs
    if ecart > 0.1
      assign contenu = true
    endif
  endif
  assign generee = false
  if alt_bas contains 'image générée' or alt_bas contains 'image generee'
    assign generee = true
  endif
-%}
{%- liquid
  assign option_couleur = nil
  if compacte
    for opt in product.options_with_values
      assign nom_opt = opt.name | downcase
      if nom_opt contains 'couleur' or nom_opt contains 'color' or nom_opt contains 'coloris'
        assign option_couleur = opt
        break
      endif
    endfor
  endif
-%}
<article class="carte-produit{% if compacte %} carte-produit--compacte{% endif %}">
  <a class="carte-produit__lien" href="{{ product.url }}">
    <div class="carte-produit__visuel{% if contenu %} carte-produit__visuel--contenu{% endif %}">
      {%- if image != blank -%}
        {%- if prioritaire -%}
          {{ image | image_url: width: 1200 | image_tag: widths: '360, 540, 720, 960, 1200', sizes: sizes, loading: 'eager', alt: alt }}
        {%- else -%}
          {{ image | image_url: width: 1200 | image_tag: widths: '360, 540, 720, 960, 1200', sizes: sizes, loading: 'lazy', alt: alt }}
        {%- endif -%}
        {%- if generee and settings.credit_ia -%}
          <span class="credit carte-produit__credit">{{ 'aplomb.credit_ia' | t }}</span>
        {%- endif -%}
      {%- else -%}
        <span class="carte-produit__attente">{{ 'aplomb.cadre.attente' | t }}</span>
      {%- endif -%}
    </div>
    <div class="carte-produit__texte">
      {%- if compacte -%}
        {%- if option_couleur -%}
          <ul class="carte-produit__coloris" role="list" aria-label="{{ option_couleur.name | escape }}">
            {%- for valeur in option_couleur.values limit: 5 -%}
              {%- assign nom_valeur = valeur.name | default: valeur -%}
              {%- capture teinte -%}{% render 'teinte', nom: nom_valeur, couleur: valeur.swatch.color %}{%- endcapture -%}
              <li style="--teinte: {{ teinte }}" title="{{ nom_valeur | escape }}"><span class="visually-hidden">{{ nom_valeur }}</span></li>
            {%- endfor -%}
            {%- if option_couleur.values.size > 5 -%}
              <li class="carte-produit__coloris-plus">+{{ option_couleur.values.size | minus: 5 }}</li>
            {%- endif -%}
          </ul>
        {%- endif -%}
        <{{ titre_balise }} class="carte-produit__titre">{{ product.title }}</{{ titre_balise }}>
        {%- if option_couleur -%}
          <p class="carte-produit__variante">{{ product.selected_or_first_available_variant.title }}</p>
        {%- endif -%}
      {%- else -%}
        {%- if famille != blank -%}
          <p class="label soft">{{ famille }}</p>
        {%- endif -%}
        <{{ titre_balise }} class="carte-produit__titre">{{ product.title }}</{{ titre_balise }}>
        {%- if product.metafields.aplomb.accroche != blank -%}
          <p class="carte-produit__accroche">{{ product.metafields.aplomb.accroche }}</p>
        {%- endif -%}
      {%- endif -%}
      <p class="carte-produit__prix">
        {%- if product.price_varies -%}
          {{ 'aplomb.produit.des' | t: prix: prix }}
        {%- else -%}
          {{ prix }}
        {%- endif %}
        <small>{{ 'aplomb.produit.ttc' | t }}</small>
      </p>
      <p class="carte-produit__etat carte-produit__etat--{{ etat }}"{% if compacte and etat == 'vente' and product.available %} hidden{% endif %}>
        {%- case etat -%}
          {%- when 'vente' -%}
            {%- if product.available -%}
              {{ 'aplomb.produit.dispo_stock' | t }}
            {%- else -%}
              {{ 'aplomb.produit.dispo_epuise' | t }}
            {%- endif -%}
          {%- when 'reservation' -%}
            {{ 'aplomb.produit.dispo_reservation' | t }}
          {%- else -%}
            {{ 'aplomb.produit.dispo_attente' | t }}
        {%- endcase -%}
      </p>
    </div>
  </a>
</article>
