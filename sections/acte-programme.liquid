{%- liquid
  assign titre_id = 'titre-' | append: section.id
  assign semaines = section.blocks | where: 'type', 'semaine'
-%}
<section class="wrap grid acte" id="{{ section.settings.ancre | default: section.id }}" aria-labelledby="{{ titre_id }}">
  {% render 'acte-tete',
    num: section.settings.num,
    titre: section.settings.titre,
    intro: section.settings.intro,
    folio: section.settings.folio,
    id: titre_id
  %}
  <div class="acte__corps">
    {%- if section.settings.chapeau != blank -%}
      <p class="chapeau">{{ section.settings.chapeau }}</p>
    {%- endif -%}

    {%- if semaines.size > 0 -%}
      <ol class="semaines">
        {%- for block in semaines -%}
          <li {{ block.shopify_attributes }}>
            <span class="semaines__num">{{ block.settings.numero }}</span>
            <h3 class="semaines__titre">{{ block.settings.titre }}</h3>
            <p class="semaines__texte">{{ block.settings.texte }}</p>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.encart_titre != blank -%}
      <div class="encart">
        <p class="label">{{ section.settings.encart_titre }}</p>
        <p>{{ section.settings.encart_texte }}</p>
      </div>
    {%- endif -%}

    {%- if section.settings.image != blank or section.settings.didascalie != blank -%}
      {% render 'cadre',
        image: section.settings.image,
        ratio: section.settings.ratio,
        class: 'cadre--etroit',
        plan: section.settings.plan,
        legende: section.settings.legende,
        didascalie: section.settings.didascalie,
        generee: section.settings.generee,
        sizes: '(min-width: 1000px) 520px, 100vw'
      %}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Acte : le programme",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "ancre",
      "label": "Ancre",
      "default": "programme"
    },
    {
      "type": "text",
      "id": "num",
      "label": "Numéro d’acte",
      "default": "III."
    },
    {
      "type": "text",
      "id": "titre",
      "label": "Titre",
      "default": "Le programme"
    },
    {
      "type": "text",
      "id": "folio",
      "label": "Folio",
      "default": "4"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "« 28 jours d’aplomb » : 4 semaines, 4 séances de 20 minutes par semaine. Accès par QR code."
    },
    {
      "type": "textarea",
      "id": "chapeau",
      "label": "Chapeau"
    },
    {
      "type": "text",
      "id": "encart_titre",
      "label": "Encart : titre",
      "default": "Édition Studio"
    },
    {
      "type": "textarea",
      "id": "encart_texte",
      "label": "Encart : texte",
      "default": "Le programme se prolonge sur 8 semaines, avec une visio collective chaque mois."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Format de la photo",
      "options": [
        {
          "value": "4/5",
          "label": "4:5"
        },
        {
          "value": "3/2",
          "label": "3:2"
        },
        {
          "value": "1/1",
          "label": "1:1"
        }
      ],
      "default": "4/5"
    },
    {
      "type": "checkbox",
      "id": "generee",
      "label": "Image générée par IA (affiche le crédit)",
      "default": true
    },
    {
      "type": "text",
      "id": "plan",
      "label": "Numéro du plan",
      "default": "06"
    },
    {
      "type": "text",
      "id": "legende",
      "label": "Légende",
      "default": "trois postures du programme"
    },
    {
      "type": "textarea",
      "id": "didascalie",
      "label": "Didascalie (sans image)"
    }
  ],
  "blocks": [
    {
      "type": "semaine",
      "name": "Semaine",
      "settings": [
        {
          "type": "text",
          "id": "numero",
          "label": "Numéro",
          "default": "S1"
        },
        {
          "type": "text",
          "id": "titre",
          "label": "Titre",
          "default": "Alignement"
        },
        {
          "type": "textarea",
          "id": "texte",
          "label": "Texte",
          "default": "4 séances de 20 minutes."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Acte : le programme"
    }
  ]
}
{% endschema %}
