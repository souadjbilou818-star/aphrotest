{%- liquid
  assign titre_id = 'titre-' | append: section.id
  assign num = collection.metafields.aplomb.numero
  assign quiz_url = settings.page_quiz.url
-%}
<section class="wrap collection" aria-labelledby="{{ titre_id }}">
  <header class="collection__tete">
    {%- if num != blank -%}
      <p class="famille__num mono">{{ num }}</p>
    {%- endif -%}
    <h1 class="collection__titre" id="{{ titre_id }}">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection__intro rte">{{ collection.description }}</div>
    {%- endif -%}
    <nav class="collection__familles" aria-label="{{ section.settings.libelle_familles }}">
      <ul>
        {%- render 'liens-familles', forme: 'onglets' -%}
      </ul>
    </nav>
  </header>

  {%- paginate collection.products by section.settings.par_page -%}
    {%- if collection.products.size > 0 -%}
      <ul class="grille-produits" role="list">
        {%- for product in collection.products -%}
          <li>
            {%- if forloop.index <= 2 -%}
              {% render 'carte-produit', product: product, titre_balise: 'h2', prioritaire: true %}
            {%- else -%}
              {% render 'carte-produit', product: product, titre_balise: 'h2' %}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- if paginate.previous -%}<a class="lien" href="{{ paginate.previous.url }}">← {{ paginate.previous.title }}</a>{%- endif -%}
          <span class="mono">{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a class="lien" href="{{ paginate.next.url }}">{{ paginate.next.title }} →</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p class="collection__vide">{{ section.settings.texte_vide }}</p>
    {%- endif -%}
  {%- endpaginate -%}

  {%- if quiz_url != blank and section.settings.texte_quiz != blank -%}
    <p class="collection__quiz">
      <a class="btn btn--line" href="{{ quiz_url }}">{{ section.settings.texte_quiz }}</a>
    </p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "par_page",
      "label": "Produits par page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    },
    {
      "type": "text",
      "id": "libelle_familles",
      "label": "Nom de la navigation des familles",
      "default": "Les familles"
    },
    {
      "type": "text",
      "id": "texte_vide",
      "label": "Collection vide",
      "default": "Cette famille arrive bientôt. Inscrivez-vous à la liste d’attente depuis l’accueil."
    },
    {
      "type": "text",
      "id": "texte_quiz",
      "label": "Lien vers le quiz",
      "default": "Vous hésitez ? Quatre questions pour choisir"
    }
  ]
}
{% endschema %}
