{%- liquid
  assign titre_id = 'titre-' | append: section.id
  assign questions = section.blocks | where: 'type', 'question'
-%}
{%- if questions.size > 0 -%}
  <section class="wrap grid acte acte--serre" id="{{ section.settings.ancre | default: section.id }}" aria-labelledby="{{ titre_id }}">
    {% render 'acte-tete',
      num: section.settings.num,
      titre: section.settings.titre,
      intro: section.settings.intro,
      folio: section.settings.folio,
      id: titre_id
    %}
    <div class="acte__corps">
      <div class="faq">
        {%- for block in questions -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <div class="faq__reponse rte">{{ block.settings.reponse }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Questions",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "ancre",
      "label": "Ancre",
      "default": "faq"
    },
    {
      "type": "text",
      "id": "num",
      "label": "Numéro d’acte"
    },
    {
      "type": "text",
      "id": "titre",
      "label": "Titre",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "folio",
      "label": "Folio"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Comment se passe la livraison ?"
        },
        {
          "type": "richtext",
          "id": "reponse",
          "label": "Réponse",
          "default": "<p>Les délais et les frais s’affichent avant le paiement, selon votre adresse.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Questions"
    }
  ]
}
{% endschema %}
