<footer class="pied on-dark">
  {% render 'frise', id: 'pied' %}
  <div class="wrap grid pied__grille">
    <div class="pied__marque">
      <a class="marque" href="{{ routes.root_url }}" aria-label="{{ 'aplomb.accueil' | t }}">
        {% render 'logo', variante: 'principal', decoratif: true %}
      </a>
      {%- if settings.devise != blank -%}
        <p class="pied__devise">{{ settings.devise }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.maison != blank -%}
      <p class="pied__maison">{{ section.settings.maison }}</p>
    {%- endif -%}
    {%- capture liens_pied -%}
      {%- for link in section.settings.menu.links -%}
        {%- liquid
          if link.object == blank
            if link.type == 'collection_link' or link.type == 'page_link' or link.type == 'product_link' or link.type == 'blog_link' or link.type == 'article_link'
              continue
            endif
          endif
        -%}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {%- endfor -%}
    {%- endcapture -%}
    {%- if liens_pied != blank -%}
      <nav aria-label="{{ section.settings.menu.title | escape }}">
        <ul>{{ liens_pied }}</ul>
      </nav>
    {%- endif -%}
    <div class="pied__colophon">
      {%- unless section.settings.colophon contains '[' and request.design_mode == false -%}
        <span>© {{ 'now' | date: '%Y' }} {{ section.settings.colophon }}</span>
      {%- else -%}
        <span>© {{ 'now' | date: '%Y' }} {{ section.settings.colophon | split: '·' | first | strip }}</span>
      {%- endunless -%}
      {%- if settings.launch_mode == 'vente' and section.settings.mention != blank -%}
        <span>{{ section.settings.mention }}</span>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    {
      "type": "text",
      "id": "maison",
      "label": "Phrase de la maison",
      "default": "Sélectionné et contrôlé à Paris, fabriqué par une usine partenaire."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu légal",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "colophon",
      "label": "Colophon",
      "info": "Tant qu’il contient une mention entre crochets, seul le nom s’affiche sur la boutique.",
      "default": "L’Aplomb · [SIREN] · [ADRESSE]"
    },
    {
      "type": "text",
      "id": "mention",
      "label": "Mention à droite",
      "default": "Paiement sécurisé par Shopify"
    }
  ]
}
{% endschema %}
