{%- liquid
  if product != blank
    assign produit = product
  else
    assign produit = settings.produit_principal
  endif
  assign titre_id = 'titre-' | append: section.id
  assign url_essentiel = produit.url | default: routes.all_products_collection_url
  assign url_studio = url_essentiel
  assign id_essentiel = ''
  assign id_studio = ''
  for variant in produit.variants
    assign nom = variant.title | downcase
    if nom contains 'studio'
      assign id_studio = variant.id
      assign url_studio = variant.url
    elsif nom contains 'essentiel'
      assign id_essentiel = variant.id
      assign url_essentiel = variant.url
    endif
  endfor
-%}
<section class="entracte-section" id="{{ section.settings.ancre | default: section.id }}" aria-labelledby="{{ titre_id }}">
  <div class="entracte on-dark">
    <div class="wrap grid">
      <div class="entracte__inner">
        <p class="label">{{ section.settings.label }}</p>
        <h2 class="entracte__titre" id="{{ titre_id }}">{{ section.settings.titre }}</h2>
        {%- if section.settings.texte != blank -%}
          <p class="entracte__texte">{{ section.settings.texte }}</p>
        {%- endif -%}

        <aplomb-quiz
          data-url-studio="{{ url_studio }}"
          data-url-essentiel="{{ url_essentiel }}"
          data-id-studio="{{ id_studio }}"
          data-id-essentiel="{{ id_essentiel }}"
          data-voir="{{ 'aplomb.quiz.voir_resultat' | t | escape }}"
        >
          <form class="quiz" novalidate data-quiz-form>
            <fieldset class="quiz__etape" data-etape>
              <legend><span class="quiz__compte">{{ 'aplomb.quiz.question' | t: n: 1, total: 5 }}</span>Votre pratique aujourd’hui</legend>
              <div class="choix">
                <label><input type="radio" name="pratique" value="jamais">Jamais</label>
                <label><input type="radio" name="pratique" value="tapis">Sur tapis</label>
                <label><input type="radio" name="pratique" value="studio">Reformer en studio</label>
              </div>
            </fieldset>
            <fieldset class="quiz__etape" data-etape>
              <legend><span class="quiz__compte">{{ 'aplomb.quiz.question' | t: n: 2, total: 5 }}</span>Votre objectif</legend>
              <div class="choix">
                <label><input type="radio" name="objectif" value="posture">Posture et dos</label>
                <label><input type="radio" name="objectif" value="tonicite">Tonicité</label>
                <label><input type="radio" name="objectif" value="reprise">Reprise</label>
                <label><input type="radio" name="objectif" value="completer">Compléter mes cours</label>
              </div>
            </fieldset>
            <fieldset class="quiz__etape" data-etape>
              <legend><span class="quiz__compte">{{ 'aplomb.quiz.question' | t: n: 3, total: 5 }}</span>Le sol où vous pratiquerez</legend>
              <div class="choix">
                <label><input type="radio" name="sol" value="parquet">Parquet</label>
                <label><input type="radio" name="sol" value="chambre">Chambre, moquette ou tapis</label>
                <label><input type="radio" name="sol" value="dur">Sol dur</label>
              </div>
            </fieldset>
            <fieldset class="quiz__etape" data-etape>
              <legend><span class="quiz__compte">{{ 'aplomb.quiz.question' | t: n: 4, total: 5 }}</span>Combien de séances par semaine</legend>
              <div class="choix">
                <label><input type="radio" name="frequence" value="1-2">1 ou 2</label>
                <label><input type="radio" name="frequence" value="3plus">3 et plus</label>
              </div>
            </fieldset>
            <fieldset class="quiz__etape" data-etape>
              <legend><span class="quiz__compte">{{ 'aplomb.quiz.question' | t: n: 5, total: 5 }}</span>Le rangerez-vous après chaque séance ?</legend>
              <div class="choix">
                <label><input type="radio" name="rangement" value="oui">Oui</label>
                <label><input type="radio" name="rangement" value="non">Non</label>
              </div>
            </fieldset>
            <div class="quiz__nav" data-quiz-nav hidden>
              <button class="btn" type="button" data-suivant disabled>{{ 'aplomb.quiz.suivant' | t }}</button>
              <button class="lien-discret" type="button" data-precedent hidden>{{ 'aplomb.quiz.precedent' | t }}</button>
            </div>
          </form>

          <div class="quiz__resultat" data-resultat hidden tabindex="-1">
            <p class="label">{{ 'aplomb.quiz.resultat' | t }}</p>
            <p class="quiz__edition" data-edition></p>
            <p class="quiz__raison" data-raison></p>
            <div class="quiz__nav">
              <a class="btn btn--line" href="{{ url_essentiel }}" data-lien>{{ 'aplomb.produit.choisir' | t }}</a>
              <button class="lien-discret" type="button" data-recommencer>{{ 'aplomb.quiz.recommencer' | t }}</button>
            </div>
            {%- if section.settings.email -%}
              {%- form 'customer', id: 'quiz-email', class: 'waitlist' -%}
                {%- if form.posted_successfully? -%}
                  <p class="message message--ok" role="status">{{ 'aplomb.waitlist.succes' | t }}</p>
                {%- else -%}
                  <input type="hidden" name="contact[tags]" value="waitlist,aplomb,quiz" data-quiz-tags>
                  <label class="label" for="quiz-email-champ">{{ 'aplomb.quiz.email_label' | t }}</label>
                  <div class="field">
                    <input class="input" id="quiz-email-champ" type="email" name="contact[email]" autocomplete="email" inputmode="email" placeholder="{{ 'aplomb.waitlist.placeholder' | t }}" required>
                    <button class="btn btn--line" type="submit">{{ 'aplomb.quiz.email_cta' | t }}</button>
                  </div>
                  <p class="consent">{{ 'aplomb.waitlist.consentement_html' | t: url: shop.privacy_policy.url }}</p>
                {%- endif -%}
              {%- endform -%}
            {%- endif -%}
          </div>
        </aplomb-quiz>

        <p class="entracte__note">{{ section.settings.note }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Entracte : quiz",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "ancre",
      "label": "Ancre",
      "default": "entracte"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Mention",
      "default": "Entracte"
    },
    {
      "type": "text",
      "id": "titre",
      "label": "Titre",
      "default": "Quelle édition pour vous ?"
    },
    {
      "type": "textarea",
      "id": "texte",
      "label": "Texte",
      "default": "Cinq questions, deux minutes. Le résultat présélectionne l’édition ; l’e-mail reste facultatif."
    },
    {
      "type": "checkbox",
      "id": "email",
      "label": "Proposer de recevoir le résultat par e-mail",
      "default": true
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Mention de santé",
      "default": "Douleurs, grossesse ou post-partum : demandez l’avis de votre médecin ou kiné."
    }
  ],
  "presets": [
    {
      "name": "Entracte : quiz"
    }
  ]
}
{% endschema %}
