{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign titre_id = 'titre-' | append: section.id
  assign preuves = section.blocks | where: 'type', 'preuve'
  capture etat
    render 'etat-produit', product: product
  endcapture
  assign etat = etat | strip
  capture prix_variant
    render 'prix', montant: variant.price
  endcapture
  assign famille = product.metafields.aplomb.famille.value | default: product.type
  assign complements = product.metafields.aplomb.complements.value | default: section.settings.complements
  assign accroche = product.metafields.aplomb.accroche | default: section.settings.accroche
-%}
<section class="wrap produit" aria-labelledby="{{ titre_id }}" data-produit-id="{{ product.id }}">
  <div class="produit__medias">
    {% render 'galerie-produit', product: product, uid: section.id %}
  </div>

  <div class="produit__achat" id="achat">
    {%- if famille != blank -%}
      <p class="label soft">{{ famille }}</p>
    {%- endif -%}
    <h1 class="produit__titre" id="{{ titre_id }}">{{ product.title }}</h1>
    {%- if accroche != blank -%}
      <p class="produit__accroche">{{ accroche }}</p>
    {%- endif -%}

    <div class="produit__prix-ligne">
      <p class="produit__prix"><span data-prix>{{ prix_variant }}</span> <small>{{ 'aplomb.produit.ttc' | t }}</small></p>
      <p
        class="dispo dispo--{{ etat }}"
        data-dispo
        data-stock="{{ 'aplomb.produit.dispo_stock' | t | escape }}"
        data-epuise="{{ 'aplomb.produit.dispo_epuise' | t | escape }}"
      >
        {%- case etat -%}
          {%- when 'vente' -%}
            {%- if variant.available -%}
              {{ 'aplomb.produit.dispo_stock' | t }}
            {%- else -%}
              {{ 'aplomb.produit.dispo_epuise' | t }}
            {%- endif -%}
          {%- when 'reservation' -%}
            {{ 'aplomb.produit.dispo_reservation' | t }}
          {%- else -%}
            {{ 'aplomb.produit.dispo_attente' | t }}
        {%- endcase -%}
      </p>
    </div>

    {% render 'selecteur-variantes', product: product, uid: section.id %}

    {%- if section.settings.mention_prix != blank -%}
      <p class="mention">{{ section.settings.mention_prix }}</p>
    {%- endif -%}

    <div data-cta-principal>
      {% render 'achat', product: product, contexte: 'produit', variant: variant, complements: complements %}
    </div>

    <ul class="infos-achat">
      {%- if settings.info_livraison != blank -%}
        <li><b class="label">Livraison</b> <span>{{ settings.info_livraison }}</span></li>
      {%- endif -%}
      {%- if settings.info_retours != blank -%}
        <li><b class="label">Retours</b> <span>{{ settings.info_retours }}</span></li>
      {%- endif -%}
      {%- if settings.info_garantie != blank -%}
        <li><b class="label">Garantie</b> <span>{{ settings.info_garantie }}</span></li>
      {%- endif -%}
      {%- if etat == 'vente' and settings.info_paiement != blank -%}
        <li><b class="label">Paiement</b> <span>{{ settings.info_paiement }}</span></li>
      {%- endif -%}
    </ul>
    {%- if settings.page_livraison != blank -%}
      <a class="lien petit" href="{{ settings.page_livraison.url }}">{{ settings.page_livraison.title }}</a>
    {%- endif -%}

    {%- if preuves.size > 0 -%}
      <ul class="preuves">
        {%- for block in preuves -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.texte }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if product.description != blank -%}
      <details class="produit__description">
        <summary class="label">{{ section.settings.titre_description }}</summary>
        <div class="rte">{{ product.description }}</div>
      </details>
    {%- endif -%}
  </div>
</section>

<aplomb-collant class="collant" data-cible="[data-cta-principal]" aria-hidden="true" inert>
  <span class="collant__produit">
    <b>{{ product.title }}</b>
    <span><span data-prix>{{ prix_variant }}</span> {{ 'aplomb.produit.ttc' | t }}</span>
  </span>
  {%- case etat -%}
    {%- when 'vente' -%}
      <button class="btn btn--sm" type="submit" form="achat-produit-{{ product.id }}" data-collant-bouton {% unless variant.available %}disabled{% endunless %}>
        {%- if variant.available -%}
          {{ 'aplomb.vente.cta_court' | t }}
        {%- else -%}
          {{ 'aplomb.vente.epuise' | t }}
        {%- endif -%}
      </button>
    {%- when 'reservation' -%}
      <button class="btn btn--sm" type="submit" form="achat-produit-{{ product.id }}">{{ 'aplomb.reservation.cta' | t: prix: '' | remove: ' — ' }}</button>
    {%- else -%}
      <a class="btn btn--sm" href="#liste-produit-email">{{ 'aplomb.waitlist.cta_court' | t }}</a>
  {%- endcase -%}
</aplomb-collant>

{% schema %}
{
  "name": "Fiche produit",
  "tag": "div",
  "class": "section-produit",
  "settings": [
    {
      "type": "textarea",
      "id": "accroche",
      "label": "Accroche par défaut",
      "info": "Remplacée par le metafield du produit aplomb.accroche quand il est rempli."
    },
    {
      "type": "textarea",
      "id": "mention_prix",
      "label": "Mention sous le prix",
      "info": "Une phrase vérifiable seulement. Pas de prix barré, pas de compte à rebours."
    },
    {
      "type": "product_list",
      "id": "complements",
      "label": "Produits en complément",
      "info": "Proposés en cases à cocher sous le bouton d’achat. Remplacés par le metafield aplomb.complements du produit.",
      "limit": 3
    },
    {
      "type": "text",
      "id": "titre_description",
      "label": "Titre de la description",
      "default": "Description"
    }
  ],
  "blocks": [
    {
      "type": "preuve",
      "name": "Fait vérifiable",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "texte",
          "label": "Texte",
          "info": "Un fait que vous pouvez prouver (matière, contenu, dimension). Pas d’avis inventé.",
          "default": "Deux plateaux qui coulissent indépendamment"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
