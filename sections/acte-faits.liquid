{%- liquid
  assign titre_id = 'titre-' | append: section.id
  assign faits = section.blocks | where: 'type', 'fait'
  assign cadres = section.blocks | where: 'type', 'cadre'
-%}
<section class="wrap grid acte" id="{{ section.settings.ancre | default: section.id }}" aria-labelledby="{{ titre_id }}">
  {% render 'acte-tete',
    num: section.settings.num,
    titre: section.settings.titre,
    intro: section.settings.intro,
    folio: section.settings.folio,
    id: titre_id
  %}
  <div class="acte__corps">
    {%- if section.settings.chapeau != blank -%}
      <p class="chapeau">{{ section.settings.chapeau }}</p>
    {%- endif -%}

    {%- if faits.size > 0 -%}
      <ul class="faits">
        {%- for block in faits -%}
          <li {{ block.shopify_attributes }}>
            <h3 class="faits__titre">{{ block.settings.titre }}</h3>
            <div class="faits__texte">{{ block.settings.texte }}</div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if cadres.size > 0 -%}
      <div class="cadres{% if cadres.size == 2 %} cadres--2{% elsif cadres.size > 2 %} cadres--3{% endif %}">
        {%- for block in cadres -%}
          <div {{ block.shopify_attributes }}>
            {% render 'cadre',
              image: block.settings.image,
              ratio: block.settings.ratio,
              plan: block.settings.plan,
              legende: block.settings.legende,
              didascalie: block.settings.didascalie,
              generee: block.settings.generee,
              sizes: '(min-width: 1000px) 40vw, 100vw'
            %}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.frise -%}
      {% render 'frise', id: section.id %}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Acte : faits et photos",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "ancre",
      "label": "Ancre",
      "default": "appartement"
    },
    {
      "type": "text",
      "id": "num",
      "label": "Numéro d’acte",
      "default": "II."
    },
    {
      "type": "text",
      "id": "titre",
      "label": "Titre",
      "default": "L’appartement"
    },
    {
      "type": "text",
      "id": "folio",
      "label": "Folio",
      "default": "3"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Pensé pour un deux-pièces, pas pour une salle de sport."
    },
    {
      "type": "textarea",
      "id": "chapeau",
      "label": "Chapeau"
    },
    {
      "type": "checkbox",
      "id": "frise",
      "label": "Frise point de Hongrie en fin d’acte",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "fait",
      "name": "Fait",
      "settings": [
        {
          "type": "text",
          "id": "titre",
          "label": "Titre",
          "default": "Rangé debout"
        },
        {
          "type": "richtext",
          "id": "texte",
          "label": "Texte",
          "default": "<p>Plié en deux sur sa charnière, il tient debout derrière une porte.</p>"
        }
      ]
    },
    {
      "type": "cadre",
      "name": "Cadre photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "checkbox",
          "id": "generee",
          "label": "Image générée par IA (affiche le crédit)",
          "default": true
        },
        {
          "type": "select",
          "id": "ratio",
          "label": "Format",
          "options": [
            {
              "value": "3/2",
              "label": "3:2"
            },
            {
              "value": "4/5",
              "label": "4:5"
            },
            {
              "value": "1/1",
              "label": "1:1"
            },
            {
              "value": "16/9",
              "label": "16:9"
            }
          ],
          "default": "4/5"
        },
        {
          "type": "text",
          "id": "plan",
          "label": "Numéro du plan",
          "default": "05"
        },
        {
          "type": "text",
          "id": "legende",
          "label": "Légende",
          "default": "rangé debout contre une moulure"
        },
        {
          "type": "textarea",
          "id": "didascalie",
          "label": "Didascalie (affichée tant qu’il n’y a pas d’image)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Acte : faits et photos"
    }
  ]
}
{% endschema %}
