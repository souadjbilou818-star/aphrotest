{%- liquid
  assign logo = settings.logo
  unless logo.src
    assign logo = images['laplomb-logo.png']
  endunless
  assign mode = settings.launch_mode
  assign liens = section.settings.menu.links
  assign quiz_url = settings.page_quiz.url
  assign montre_panier = false
  if mode != 'waitlist' or cart.item_count > 0
    assign montre_panier = true
  endif
-%}
{%- capture liens_nav -%}
  {%- if liens.size > 0 -%}
    {%- for link in liens -%}
      {%- liquid
        if link.object == blank
          if link.type == 'collection_link' or link.type == 'page_link' or link.type == 'product_link' or link.type == 'blog_link' or link.type == 'article_link'
            continue
          endif
        endif
      -%}
      <li><a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a></li>
    {%- endfor -%}
  {%- else -%}
    {%- render 'liens-familles', forme: 'nav' -%}
  {%- endif -%}
{%- endcapture -%}
<header class="masthead">
  <div class="wrap masthead__barre">
    {%- if liens_nav != blank or quiz_url != blank -%}
      <details class="menu-mobile" data-menu-mobile>
        <summary class="menu-mobile__bouton" aria-label="{{ 'aplomb.menu' | t }}">
          {%- render 'icone', nom: 'menu' -%}
          <span class="label">{{ 'aplomb.menu' | t }}</span>
        </summary>
        <nav class="menu-mobile__panneau" aria-label="{{ 'aplomb.menu' | t }}">
          <ul>
            {{ liens_nav }}
            {%- if quiz_url != blank -%}
              <li><a class="menu-mobile__quiz" href="{{ quiz_url }}">{{ section.settings.libelle_quiz }}</a></li>
            {%- endif -%}
          </ul>
        </nav>
      </details>
    {%- else -%}
      <span class="menu-mobile" aria-hidden="true"></span>
    {%- endif -%}

    <a class="marque" href="{{ routes.root_url }}" aria-label="{{ 'aplomb.accueil' | t }}" style="--logo-l: {{ settings.logo_largeur | default: 170 }}px">
      {%- if logo.src -%}
        {{- logo | image_url: width: 600 | image_tag: widths: '200, 300, 400, 600', sizes: '(min-width: 900px) 280px, 160px', class: 'logo-image', alt: '', loading: 'eager' -}}
      {%- else -%}
        {% render 'logo', variante: 'compact', decoratif: true %}
      {%- endif -%}
    </a>

    {%- if liens_nav != blank -%}
      <nav class="masthead__nav" aria-label="{{ 'aplomb.menu' | t }}">
        <ul>{{ liens_nav }}</ul>
      </nav>
    {%- else -%}
      <span class="masthead__nav" aria-hidden="true"></span>
    {%- endif -%}

    <div class="masthead__actions">
      {%- if quiz_url != blank -%}
        <a class="btn btn--line btn--sm masthead__quiz" href="{{ quiz_url }}">{{ section.settings.libelle_quiz }}</a>
      {%- elsif mode == 'waitlist' -%}
        <a class="btn btn--line btn--sm" href="{{ routes.root_url }}#liste-cloture-email">{{ 'aplomb.waitlist.cta_court' | t }}</a>
      {%- endif -%}
      <a class="panier-lien masthead__recherche" href="{{ routes.search_url }}" aria-label="{{ 'aplomb.recherche' | t }}">
        {%- render 'icone', nom: 'recherche' -%}
      </a>
      {%- if montre_panier -%}
        <a class="panier-lien" href="{{ routes.cart_url }}" data-panier-ouvrir>
          {%- render 'icone', nom: 'panier' -%}
          <span class="visually-hidden">{{ 'aplomb.panier.ouvrir' | t }},</span>
          <span class="panier-lien__compte" data-panier-compte>{{ cart.item_count }}</span>
          <span class="visually-hidden">{{ 'aplomb.panier.articles' | t: count: cart.item_count }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
  <div class="wrap"><hr class="filet filet--double"></div>
</header>

{% schema %}
{
  "name": "En-tête",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Vide : l’en-tête affiche les trois familles choisies dans Réglages du thème > Boutique."
    },
    {
      "type": "text",
      "id": "libelle_quiz",
      "label": "Libellé du lien vers le quiz",
      "default": "Trouver mon équipement"
    }
  ]
}
{% endschema %}
