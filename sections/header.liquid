{%- liquid
  assign mode = settings.launch_mode
  assign produit = settings.produit_principal
  if mode == 'waitlist'
    if template.name == 'index'
      assign cta_url = '#liste-hero-email'
    elsif template.name == 'product'
      assign cta_url = '#liste-produit-email'
    else
      assign cta_url = routes.root_url | append: '#liste-hero-email'
    endif
    assign cta_label = 'aplomb.waitlist.cta_court' | t
  else
    assign cta_url = produit.url | default: routes.all_products_collection_url
    assign cta_label = 'aplomb.produit.choisir' | t
  endif
-%}
<header class="masthead">
  <div class="wrap">
    <div class="masthead__barre">
      <a class="marque" href="{{ routes.root_url }}" aria-label="{{ 'aplomb.accueil' | t }}">
        {% render 'logo', variante: 'compact', decoratif: true %}
      </a>

      {%- if section.settings.menu.links.size > 0 -%}
        <nav class="masthead__nav" aria-label="{{ 'aplomb.menu' | t }}">
          <ul>
            {%- for link in section.settings.menu.links -%}
              <li>
                <a class="label" href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                  {{- link.title -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      <div class="masthead__actions">
        {%- unless template.name == 'product' and mode != 'waitlist' -%}
          <a class="btn btn--line btn--sm" href="{{ cta_url }}">{{ cta_label }}</a>
        {%- endunless -%}
        {%- if mode != 'waitlist' -%}
          <a class="panier-lien" href="{{ routes.cart_url }}">
            {{- 'cart.title' | t -}}
            <span>({{ cart.item_count }})</span>
          </a>
        {%- endif -%}
        {%- if section.settings.menu.links.size > 0 -%}
          <details class="menu-mobile">
            <summary class="label">{{ 'aplomb.menu' | t }}</summary>
            <nav class="menu-mobile__panneau" aria-label="{{ 'aplomb.menu' | t }}">
              <ul>
                {%- for link in section.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            </nav>
          </details>
        {%- endif -%}
      </div>
    </div>
    <hr class="filet filet--double">
  </div>
</header>

{% schema %}
{
  "name": "En-tête",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
