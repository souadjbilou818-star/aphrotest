{%- liquid
  assign produit = settings.produit_principal
  assign titre = section.settings.titre | escape | replace: 'mini-reformer', '<span class="nowrap">mini-reformer</span>'
-%}
<section class="wrap grid hero" aria-labelledby="titre-{{ section.id }}">
  <div class="hero__meta">
    <span class="label">{{ section.settings.label_gauche }}</span>
    {%- if settings.devise != blank -%}
      <span class="hero__devise">{{ settings.devise }}</span>
    {%- endif -%}
    <span class="label hero__lieu">{{ section.settings.label_droite }}</span>
  </div>

  <h1 class="hero__titre" id="titre-{{ section.id }}">
    {{- titre }}
    {% if section.settings.titre_italique != blank -%}
      <em class="hero__accent">{{ section.settings.titre_italique }}</em>
    {%- endif -%}
  </h1>

  {%- if section.settings.sous_titre != blank -%}
    <p class="hero__lead">{{ section.settings.sous_titre }}</p>
  {%- endif -%}

  {%- if section.settings.afficher_dessin -%}
    <figure class="hero__dessin">
      {%- if section.settings.image != blank -%}
        {% render 'cadre',
          image: section.settings.image,
          ratio: '3/2',
          legende: section.settings.legende_dessin,
          generee: section.settings.image_generee,
          prioritaire: true,
          sizes: '(min-width: 1000px) 60vw, 100vw'
        %}
      {%- else -%}
        {% render 'dessin-reformer', detail: 'simple', timeline: 'root', product: produit, uid: section.id %}
        {%- if section.settings.legende_dessin != blank -%}
          <figcaption class="legende">{{ section.settings.legende_dessin }}</figcaption>
        {%- endif -%}
      {%- endif -%}
    </figure>
  {%- endif -%}

  <div class="hero__cta" id="liste">
    {% render 'cta', contexte: 'hero', product: produit %}
  </div>

  {%- assign preuves = section.blocks | where: 'type', 'preuve' -%}
  {%- if preuves.size > 0 -%}
    <ul class="preuves hero__preuves">
      {%- for block in preuves -%}
        <li {{ block.shopify_attributes }}>{{ block.settings.texte }}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- assign entrees = section.blocks | where: 'type', 'sommaire' -%}
  {%- if entrees.size > 0 -%}
    <nav class="sommaire" aria-labelledby="sommaire-{{ section.id }}">
      <p class="label soft" id="sommaire-{{ section.id }}">{{ 'aplomb.au_programme' | t }}</p>
      <ol>
        {%- for block in entrees -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ block.settings.ancre }}">
              <span class="sommaire__num">{{ block.settings.num | default: '—' }}</span>
              <span class="sommaire__titre">{{ block.settings.titre }}</span>
              <span class="sommaire__folio">{{ block.settings.folio }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ol>
    </nav>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero, feuille de salle",
  "tag": "div",
  "class": "section-hero",
  "settings": [
    {
      "type": "text",
      "id": "label_gauche",
      "label": "Mention à gauche",
      "default": "Feuille de salle n° 1"
    },
    {
      "type": "text",
      "id": "label_droite",
      "label": "Mention à droite",
      "default": "Pré-lancement · Paris"
    },
    {
      "type": "text",
      "id": "titre",
      "label": "Titre (romain)",
      "default": "Le mini-reformer à chariot,"
    },
    {
      "type": "text",
      "id": "titre_italique",
      "label": "Titre (italique)",
      "default": "pensé pour l’appartement."
    },
    {
      "type": "textarea",
      "id": "sous_titre",
      "label": "Sous-titre",
      "default": "Plateau bois, rails acier, chariot sur roues silencieuses. Se range debout derrière une porte."
    },
    {
      "type": "checkbox",
      "id": "afficher_dessin",
      "label": "Afficher le visuel",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo (remplace le dessin technique)",
      "info": "Plan 01 : le mini-reformer sur parquet, plongée à 45°."
    },
    {
      "type": "checkbox",
      "id": "image_generee",
      "label": "Photo générée par IA (affiche le crédit)",
      "default": true
    },
    {
      "type": "text",
      "id": "legende_dessin",
      "label": "Légende",
      "default": "Planche 01 — vue de dessus et élévation. Faites défiler : le chariot glisse sur ses rails."
    }
  ],
  "blocks": [
    {
      "type": "preuve",
      "name": "Micro-preuve",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "texte",
          "label": "Texte",
          "default": "Un vrai chariot sur rails acier"
        }
      ]
    },
    {
      "type": "sommaire",
      "name": "Entrée du sommaire",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "num",
          "label": "Numéro",
          "default": "I."
        },
        {
          "type": "text",
          "id": "titre",
          "label": "Titre",
          "default": "Le chariot"
        },
        {
          "type": "text",
          "id": "ancre",
          "label": "Lien (ancre)",
          "default": "#chariot"
        },
        {
          "type": "text",
          "id": "folio",
          "label": "Folio",
          "default": "2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero, feuille de salle"
    }
  ]
}
{% endschema %}
