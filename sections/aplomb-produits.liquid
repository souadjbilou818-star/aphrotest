{%- liquid
  assign titre_id = 'titre-' | append: section.id
  assign c = section.settings.collection
  assign c_ok = false
  if c and c.published_at and c.products_count > 0
    assign c_ok = true
  endif
-%}
{%- if c_ok -%}
  {%- capture cartes -%}
    {%- for p in c.products limit: section.settings.nombre -%}
      {%- if p.id != product.id -%}
        {%- if section.settings.style_carte == 'compacte' -%}
          <li>{% render 'carte-produit', product: p, compacte: true, sizes: '(min-width: 1000px) 23vw, 70vw' %}</li>
        {%- else -%}
          <li>{% render 'carte-produit', product: p %}</li>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if cartes != blank -%}
    <section class="wrap rangee rangee--{{ section.settings.colonnes }}" id="{{ section.settings.ancre | default: section.id }}" aria-labelledby="{{ titre_id }}">
      <div class="rangee__tete">
        <h2 class="rangee__titre" id="{{ titre_id }}">{{ section.settings.titre }}</h2>
        {%- if section.settings.libelle_lien != blank -%}
          <a class="btn btn--line btn--sm" href="{{ c.url }}">{{ section.settings.libelle_lien }}</a>
        {%- endif -%}
      </div>
      <aplomb-carrousel class="carrousel">
        <ul class="rangee__liste" role="list" data-carrousel-liste>{{ cartes }}</ul>
        <div class="carrousel__nav">
          <button class="carrousel__fleche" type="button" data-carrousel-prec aria-label="{{ 'aplomb.carrousel.precedent' | t }}">{% render 'icone', nom: 'gauche' %}</button>
          <button class="carrousel__fleche" type="button" data-carrousel-suiv aria-label="{{ 'aplomb.carrousel.suivant' | t }}">{% render 'icone', nom: 'droite' %}</button>
        </div>
      </aplomb-carrousel>
    </section>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Rangée de produits",
  "tag": "div",
  "class": "section-rangee",
  "settings": [
    {
      "type": "text",
      "id": "ancre",
      "label": "Ancre"
    },
    {
      "type": "text",
      "id": "titre",
      "label": "Titre",
      "default": "Compléter votre espace"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Masquée tant que la collection n’est pas publiée ou qu’elle est vide."
    },
    {
      "type": "range",
      "id": "nombre",
      "label": "Nombre de produits",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "style_carte",
      "label": "Style des cartes",
      "options": [
        {
          "value": "complete",
          "label": "Complètes (famille, accroche, disponibilité)"
        },
        {
          "value": "compacte",
          "label": "Compactes (image, coloris, nom, prix)"
        }
      ],
      "default": "complete"
    },
    {
      "type": "select",
      "id": "colonnes",
      "label": "Produits visibles sur ordinateur",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "text",
      "id": "libelle_lien",
      "label": "Lien vers la collection",
      "info": "Vide : pas de lien.",
      "default": "Tout voir"
    }
  ],
  "presets": [
    {
      "name": "Rangée de produits"
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
